rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'infowarspakistan@gmail.com' && isEmailVerified()) ||
        userRole() == 'admin'
      );
    }

    function isStaffEditor() {
      return isAdmin() || (isSignedIn() && userRole() in ['admin', 'editor']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints
    function isValidQuoteRequest(data) {
      return data.keys().hasAll(['fullName', 'companyName', 'email', 'phone', 'projectTypes', 'budget', 'timeline', 'details', 'status', 'createdAt'])
        && data.keys().size() == 10
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200
        && data.companyName is string && data.companyName.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 50
        && data.projectTypes is list && data.projectTypes.size() <= 20
        && data.budget is string && data.budget.size() <= 100
        && data.timeline is string && data.timeline.size() <= 100
        && data.details is string && data.details.size() <= 2000
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'customerName', 'customerEmail', 'items',
          'subtotal', 'tax', 'shippingCost', 'total',
          'orderStatus', 'paymentStatus', 'shippingAddress', 'billingAddress',
          'paymentMethod', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'customerId', 'customerName', 'customerEmail', 'customerPhone',
          'items', 'subtotal', 'tax', 'shippingCost', 'total',
          'orderStatus', 'paymentStatus', 'shippingAddress', 'billingAddress',
          'paymentMethod', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 200
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200
        && (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 200))
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 500000000
        && data.tax is number && data.tax >= 0 && data.tax <= 500000000
        && data.shippingCost is number && data.shippingCost >= 0 && data.shippingCost <= 50000000
        && data.total is number && data.total >= 0 && data.total <= 500000000
        && data.orderStatus == 'pending'
        && data.paymentStatus == 'pending'
        && data.shippingAddress is string && data.shippingAddress.size() <= 500
        && data.billingAddress is string && data.billingAddress.size() <= 500
        && data.paymentMethod is string && data.paymentMethod.size() <= 50
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidRmaRequest(data) {
      return data.keys().hasAll(['orderNumber', 'productName', 'sku', 'issueType', 'description', 'customerEmail', 'customerPhone', 'status', 'createdAt'])
        && data.keys().size() == 9
        && data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 100
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 200
        && data.sku is string && data.sku.size() <= 100
        && data.issueType is string && data.issueType.size() <= 100
        && data.description is string && data.description.size() <= 3000
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200
        && data.customerPhone is string && data.customerPhone.size() <= 50
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    function isValidWizardLead(data) {
      return data.keys().hasAll(['customerName', 'email', 'company', 'phone', 'notes', 'answers', 'recommendedBundle', 'selectedAddons', 'totalProjectEstimate', 'createdAt', 'status'])
        && data.keys().size() == 11
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.company is string && data.company.size() <= 200
        && data.phone is string && data.phone.size() <= 50
        && data.notes is string && data.notes.size() <= 2000
        && data.answers is map && data.answers.size() <= 10
        && data.recommendedBundle is string && data.recommendedBundle.size() <= 200
        && data.selectedAddons is list && data.selectedAddons.size() <= 20
        && data.totalProjectEstimate is number && data.totalProjectEstimate >= 0 && data.totalProjectEstimate <= 500000000
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    function isValidEventQuote(data) {
      return data.keys().hasAll(['fullName', 'email', 'phone', 'eventType', 'eventSubType', 'status', 'createdAt'])
        && data.keys().size() <= 25
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 50
        && data.eventType is string && data.eventType.size() <= 100
        && data.eventSubType is string && data.eventSubType.size() <= 100
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['fullName', 'organization', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
        && data.keys().size() == 8
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 200
        && data.organization is string && data.organization.size() <= 200
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 50
        && data.subject is string && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    function isValidResellerApp(data) {
      return data.keys().hasAll(['companyName', 'ntn', 'email', 'details', 'status', 'createdAt'])
        && data.keys().size() == 6
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 200
        && data.ntn is string && data.ntn.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.details is string && data.details.size() <= 3000
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasOnly(['email', 'createdAt', 'source'])
        && data.keys().hasAll(['email', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
        && (!('source' in data) || (data.source is string && data.source.size() <= 100))
        && data.createdAt == request.time;
    }

    function isValidFacebookPost(data) {
      return data.keys().hasAll(['pageId', 'pageName', 'itemType', 'itemId', 'title', 'message', 'postFormat', 'linkUrl', 'imageUrl', 'facebookPostId', 'permalinkUrl', 'status', 'errorMessage', 'publishedBy', 'createdAt'])
        && data.keys().hasOnly(['pageId', 'pageName', 'itemType', 'itemId', 'title', 'message', 'postFormat', 'linkUrl', 'imageUrl', 'facebookPostId', 'permalinkUrl', 'status', 'errorMessage', 'publishedBy', 'createdAt'])
        && data.pageId is string && data.pageId.size() >= 1 && data.pageId.size() <= 64
        && data.pageName is string && data.pageName.size() >= 1 && data.pageName.size() <= 200
        && data.itemType in ['product', 'service', 'custom']
        && data.itemId is string && data.itemId.size() <= 150
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
        && data.postFormat in ['photo', 'link', 'text']
        && data.linkUrl is string && data.linkUrl.size() <= 500
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.facebookPostId is string && data.facebookPostId.size() <= 150
        && data.permalinkUrl is string && data.permalinkUrl.size() <= 500
        && data.status in ['published', 'failed']
        && data.errorMessage is string && data.errorMessage.size() <= 500
        && data.publishedBy is string && data.publishedBy.size() >= 1 && data.publishedBy.size() <= 200
        && data.createdAt == request.time;
    }

    function isValidAILead(data) {
      return data.keys().hasAll(['name', 'phone', 'channel', 'language', 'stage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'name', 'company', 'phone', 'email', 'city', 'channel', 'language',
          'stage', 'intentSummary', 'interestedSkus', 'estimatedValuePkr',
          'escalated', 'sheetSyncedAt', 'lastContactAt', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('company' in data) || (data.company is string && data.company.size() <= 200))
        && data.phone is string && data.phone.size() <= 50
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && data.channel in ['whatsapp', 'phone_3cx', 'web_chat', 'email']
        && data.language in ['en', 'ur', 'roman_ur']
        && data.stage in ['new', 'qualified', 'quoted', 'follow_up', 'won', 'lost']
        && (!('intentSummary' in data) || (data.intentSummary is string && data.intentSummary.size() <= 1000))
        && (!('interestedSkus' in data) || (data.interestedSkus is list && data.interestedSkus.size() <= 20))
        && (!('estimatedValuePkr' in data) || (data.estimatedValuePkr is number && data.estimatedValuePkr >= 0 && data.estimatedValuePkr <= 500000000))
        && (!('escalated' in data) || data.escalated is bool)
        && (!('sheetSyncedAt' in data) || (data.sheetSyncedAt is string && data.sheetSyncedAt.size() <= 64));
    }

    function isValidAIConversation(data) {
      return data.keys().hasAll(['customerName', 'channel', 'language', 'status', 'messages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'leadId', 'customerName', 'customerPhone', 'channel', 'language',
          'status', 'lastMessage', 'messages', 'createdAt', 'updatedAt'
        ])
        && (!('leadId' in data) || (data.leadId is string && data.leadId.size() <= 128))
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 200
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50))
        && data.channel in ['whatsapp', 'phone_3cx', 'web_chat']
        && data.language in ['en', 'ur', 'roman_ur']
        && data.status in ['open', 'escalated', 'resolved']
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000))
        && data.messages is list && data.messages.size() <= 100;
    }

    function isValidAIApprovalItem(data) {
      return data.keys().hasAll(['type', 'recipientName', 'subject', 'bodyText', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'type', 'leadId', 'recipientName', 'recipientEmail', 'recipientPhone',
          'subject', 'bodyHtml', 'bodyText', 'quoteTotalPkr', 'quoteItems',
          'buttons', 'status', 'approvedBy', 'sentAt', 'createdAt', 'updatedAt'
        ])
        && data.type in ['gmail_quote', 'gmail_followup', 'gmail_daily_report', 'whatsapp_followup']
        && (!('leadId' in data) || (data.leadId is string && data.leadId.size() <= 128))
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 200
        && (!('recipientEmail' in data) || (data.recipientEmail is string && data.recipientEmail.size() <= 200))
        && (!('recipientPhone' in data) || (data.recipientPhone is string && data.recipientPhone.size() <= 50))
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 300
        && (!('bodyHtml' in data) || (data.bodyHtml is string && data.bodyHtml.size() <= 15000))
        && data.bodyText is string && data.bodyText.size() >= 1 && data.bodyText.size() <= 5000
        && (!('quoteTotalPkr' in data) || (data.quoteTotalPkr is number && data.quoteTotalPkr >= 0 && data.quoteTotalPkr <= 500000000))
        && (!('quoteItems' in data) || (data.quoteItems is list && data.quoteItems.size() <= 50))
        && (!('buttons' in data) || (data.buttons is list && data.buttons.size() <= 5))
        && data.status in ['pending_approval', 'sent', 'rejected']
        && (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 200))
        && (!('sentAt' in data) || (data.sentAt is string && data.sentAt.size() <= 64));
    }

    function isValidAITask(data) {
      return data.keys().hasAll(['title', 'cadenceStep', 'channel', 'priority', 'status', 'dueAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'leadId', 'leadName', 'title', 'notes', 'cadenceStep', 'channel',
          'priority', 'status', 'dueAt', 'googleTaskId', 'createdAt', 'updatedAt'
        ])
        && (!('leadId' in data) || (data.leadId is string && data.leadId.size() <= 128))
        && (!('leadName' in data) || (data.leadName is string && data.leadName.size() <= 200))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.cadenceStep in ['day_1', 'day_3', 'day_7', 'custom']
        && data.channel in ['whatsapp', 'phone_3cx', 'email', 'internal']
        && data.priority in ['high', 'medium', 'low']
        && data.status in ['pending', 'completed', 'snoozed']
        && data.dueAt is string && data.dueAt.size() >= 4 && data.dueAt.size() <= 64
        && (!('googleTaskId' in data) || (data.googleTaskId is string && data.googleTaskId.size() <= 200));
    }

    function isValidAIDailyReport(data) {
      return data.keys().hasAll(['reportDate', 'summaryText', 'metrics', 'status', 'createdAt'])
        && data.keys().hasOnly(['reportDate', 'summaryText', 'summaryHtml', 'metrics', 'status', 'sentTo', 'createdAt'])
        && data.reportDate is string && data.reportDate.size() >= 4 && data.reportDate.size() <= 32
        && data.summaryText is string && data.summaryText.size() >= 1 && data.summaryText.size() <= 6000
        && (!('summaryHtml' in data) || (data.summaryHtml is string && data.summaryHtml.size() <= 15000))
        && data.metrics is map && data.metrics.size() <= 20
        && data.status in ['draft', 'sent']
        && (!('sentTo' in data) || (data.sentTo is string && data.sentTo.size() <= 200));
    }

    // 4. Collection Matches

    // Homepage - Public read, Staff Editor write
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(docId);
    }

    // Products - Public read, Staff Editor write
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(productId);
    }

    // Product Backups - Recoverable snapshots for deleted or image-updated products
    match /product_backups/{backupId} {
      allow read, write: if isStaffEditor() && isValidId(backupId);
    }

    // Categories - Public read, Staff Editor write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(categoryId);
    }

    // About/Contact - Public read, Staff Editor write
    match /about/{docId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(docId);
    }
    match /contact/{docId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(docId);
    }

    // Orders - Validated public create, read for owner or admin, update/delete for admin
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow read: if isAdmin() || (isSignedIn() && (
        existing().customerId == request.auth.uid ||
        (isEmailVerified() && existing().customerEmail == request.auth.token.email)
      ));
      allow update, delete: if isAdmin();
    }

    // RMA Requests
    match /rma_requests/{rmaId} {
      allow create: if isValidId(rmaId) && isValidRmaRequest(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Wizard Leads
    match /wizard_leads/{leadId} {
      allow create: if isValidId(leadId) && isValidWizardLead(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Event Quotes
    match /event_quotes/{quoteId} {
      allow create: if isValidId(quoteId) && isValidEventQuote(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Contact Inquiries, Reseller Applications & Newsletter Subscriptions
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /reseller_applications/{appId} {
      allow create: if isValidId(appId) && isValidResellerApp(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /newsletter_subscribers/{subId} {
      allow create: if isValidId(subId) && isValidNewsletterSubscriber(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Quote Requests
    match /quote_requests/{quoteId} {
      allow create: if isValidId(quoteId) && isValidQuoteRequest(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Users - Profile management with least-privilege role protection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && (
        incoming().role == 'customer' ||
        (incoming().role == 'admin' && isEmailVerified() && request.auth.token.email == 'infowarspakistan@gmail.com')
      );
      allow update: if (
        isOwner(userId) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'email'])
      ) || isAdmin();
    }

    // Services Page Content
    match /services_page/{docId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(docId);
    }

    // Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(serviceId);
    }

    // Settings
    match /settings/{docId} {
      allow read: if docId == 'global' || docId == 'catalog_tombstones' || isAdmin();
      allow write: if isValidId(docId) && (docId == 'catalog_tombstones' ? isStaffEditor() : isAdmin());
    }

    // Facebook Page Publish History
    match /facebook_posts/{postId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && isValidId(postId) && isValidFacebookPost(incoming());
      allow update: if false;
    }

    // Stock History
    match /stock_history/{historyId} {
      allow read, write: if isStaffEditor() && isValidId(historyId);
    }

    // Workflow Automation (n8n)
    match /n8n_workflows/{workflowId} {
      allow read, write: if isAdmin() && isValidId(workflowId);
    }

    match /n8n_logs/{logId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Page Contents
    match /page_contents/{pageId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(pageId);
    }

    // Blog Posts
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isStaffEditor() && isValidId(postId);
    }

    // Admins - Only readable by admins; managed server-side / console
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // AI Sales & Follow-Up Agent Collections (Strictly Admin/Staff PII isolated)
    match /ai_leads/{leadId} {
      allow read: if isStaffEditor();
      allow create: if isStaffEditor() && isValidId(leadId) && isValidAILead(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isStaffEditor() && isValidId(leadId) && isValidAILead(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(leadId);
    }

    match /ai_conversations/{conversationId} {
      allow read: if isStaffEditor();
      allow create: if isStaffEditor() && isValidId(conversationId) && isValidAIConversation(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isStaffEditor() && isValidId(conversationId) && isValidAIConversation(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(conversationId);
    }

    match /ai_approval_queue/{itemId} {
      allow read: if isStaffEditor();
      allow create: if isStaffEditor() && isValidId(itemId) && isValidAIApprovalItem(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isStaffEditor() && isValidId(itemId) && isValidAIApprovalItem(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /ai_tasks/{taskId} {
      allow read: if isStaffEditor();
      allow create: if isStaffEditor() && isValidId(taskId) && isValidAITask(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isStaffEditor() && isValidId(taskId) && isValidAITask(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(taskId);
    }

    match /ai_daily_reports/{reportId} {
      allow read: if isStaffEditor();
      allow create: if isStaffEditor() && isValidId(reportId) && isValidAIDailyReport(incoming()) && incoming().createdAt == request.time;
      allow update: if isStaffEditor() && isValidId(reportId) && isValidAIDailyReport(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(reportId);
    }

    // Startup connection probe
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
