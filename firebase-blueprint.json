{
  "entities": {
    "Homepage": {
      "title": "Homepage Content",
      "description": "Content for the main landing page",
      "type": "object",
      "properties": {
        "heroSlides": { "type": "array" },
        "brands": { "type": "array" },
        "solutions": { "type": "object" },
        "stats": { "type": "object" },
        "testimonials": { "type": "array" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Inventory items available for sale",
      "type": "object",
      "properties": {
        "productName": { "type": "string" },
        "brand": { "type": "string" },
        "categoryIds": { "type": "array" },
        "categorySlugs": { "type": "array" },
        "regularPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "stock": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase records",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "shippingCost": { "type": "number" },
        "total": { "type": "number" },
        "orderStatus": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "paymentMethod": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "billingAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "RMARequest": {
      "title": "RMA Request",
      "description": "Return Merchandise Authorization requests",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "productName": { "type": "string" },
        "issue": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "received", "repaired", "replaced"] },
        "customerEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "QuoteRequest": {
      "title": "Quote Request",
      "description": "Services quotation requests",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "companyName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "projectTypes": { "type": "array" },
        "budget": { "type": "string" },
        "timeline": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "responded", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "phone", "projectTypes", "status"]
    },
    "ProductBackup": {
      "title": "Product Backup Snapshot",
      "description": "Automatic and manual JSON snapshots of products and image URLs before updates or deletions",
      "type": "object",
      "properties": {
        "originalProductId": { "type": "string" },
        "gmcId": { "type": "string" },
        "productName": { "type": "string" },
        "brand": { "type": "string" },
        "sku": { "type": "string" },
        "reason": { "type": "string", "enum": ["before_delete", "before_image_update", "manual_snapshot"] },
        "backedUpBy": { "type": "string" },
        "images": { "type": "array" },
        "productSnapshot": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FacebookPost": {
      "title": "Facebook Page Post Record",
      "description": "Audit log of products, services, and custom updates published to the connected Facebook Page",
      "type": "object",
      "properties": {
        "pageId": { "type": "string", "maxLength": 64 },
        "pageName": { "type": "string", "maxLength": 200 },
        "itemType": { "type": "string", "enum": ["product", "service", "custom"] },
        "itemId": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 300 },
        "message": { "type": "string", "maxLength": 5000 },
        "postFormat": { "type": "string", "enum": ["photo", "link", "text"] },
        "linkUrl": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "facebookPostId": { "type": "string", "maxLength": 150 },
        "permalinkUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["published", "failed"] },
        "errorMessage": { "type": "string", "maxLength": 500 },
        "publishedBy": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pageId", "pageName", "itemType", "title", "message", "postFormat", "status", "publishedBy", "createdAt"]
    },
    "AILead": {
      "title": "AI Sales Agent Lead",
      "description": "Omnichannel sales lead captured via WhatsApp Cloud API, 3CX SIP voice bridge, or Web AV Assist",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "channel": { "type": "string", "enum": ["whatsapp", "phone_3cx", "web_chat", "email"] },
        "language": { "type": "string", "enum": ["en", "ur", "roman_ur"] },
        "stage": { "type": "string", "enum": ["new", "qualified", "quoted", "follow_up", "won", "lost"] },
        "intentSummary": { "type": "string", "maxLength": 1000 },
        "interestedSkus": { "type": "array" },
        "estimatedValuePkr": { "type": "number" },
        "escalated": { "type": "boolean" },
        "sheetSyncedAt": { "type": "string", "maxLength": 64 },
        "lastContactAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "channel", "language", "stage", "createdAt", "updatedAt"]
    },
    "AIConversation": {
      "title": "AI Agent Conversation Thread",
      "description": "Concise conversation history and interactive CTA button payloads per customer session",
      "type": "object",
      "properties": {
        "leadId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "channel": { "type": "string", "enum": ["whatsapp", "phone_3cx", "web_chat"] },
        "language": { "type": "string", "enum": ["en", "ur", "roman_ur"] },
        "status": { "type": "string", "enum": ["open", "escalated", "resolved"] },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "channel", "language", "status", "messages", "createdAt", "updatedAt"]
    },
    "AIApprovalItem": {
      "title": "AI Outbound Approval Queue Item",
      "description": "Draft Gmail quotes, email follow-ups, daily reports, or WhatsApp outbound messages awaiting admin confirmation",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["gmail_quote", "gmail_followup", "gmail_daily_report", "whatsapp_followup"] },
        "leadId": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 200 },
        "recipientEmail": { "type": "string", "maxLength": 200 },
        "recipientPhone": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 300 },
        "bodyHtml": { "type": "string", "maxLength": 15000 },
        "bodyText": { "type": "string", "maxLength": 5000 },
        "quoteTotalPkr": { "type": "number" },
        "quoteItems": { "type": "array" },
        "buttons": { "type": "array" },
        "status": { "type": "string", "enum": ["pending_approval", "sent", "rejected"] },
        "approvedBy": { "type": "string", "maxLength": 200 },
        "sentAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "recipientName", "subject", "bodyText", "status", "createdAt", "updatedAt"]
    },
    "AITask": {
      "title": "AI Follow-Up Task",
      "description": "Automated Day +1, Day +3, Day +7 follow-up cadence tasks linked to leads and optionally synced to Google Tasks",
      "type": "object",
      "properties": {
        "leadId": { "type": "string", "maxLength": 128 },
        "leadName": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 2000 },
        "cadenceStep": { "type": "string", "enum": ["day_1", "day_3", "day_7", "custom"] },
        "channel": { "type": "string", "enum": ["whatsapp", "phone_3cx", "email", "internal"] },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "status": { "type": "string", "enum": ["pending", "completed", "snoozed"] },
        "dueAt": { "type": "string", "maxLength": 64 },
        "googleTaskId": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "cadenceStep", "channel", "priority", "status", "dueAt", "createdAt", "updatedAt"]
    },
    "AIDailyReport": {
      "title": "AI Daily Executive Report",
      "description": "Daily operations briefing covering calls, WhatsApp chats, leads, quotes, PKR pipeline, overdue tasks, and escalations",
      "type": "object",
      "properties": {
        "reportDate": { "type": "string", "maxLength": 32 },
        "summaryText": { "type": "string", "maxLength": 6000 },
        "summaryHtml": { "type": "string", "maxLength": 15000 },
        "metrics": { "type": "object" },
        "status": { "type": "string", "enum": ["draft", "sent"] },
        "sentTo": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportDate", "summaryText", "metrics", "status", "createdAt"]
    }
  },
  "firestore": {
    "homepage/main": {
      "schema": "Homepage",
      "description": "Main homepage configuration document"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Individual product documents"
    },
    "product_backups/{backupId}": {
      "schema": "ProductBackup",
      "description": "Recoverable product & image backup snapshots"
    },
    "categories/{categoryId}": {
      "schema": "object",
      "description": "Product categories"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer order documents"
    },
    "rma_requests/{rmaId}": {
      "schema": "RMARequest",
      "description": "Return authorization requests"
    },
    "quote_requests/{quoteId}": {
      "schema": "QuoteRequest",
      "description": "Service quote requests"
    },
    "services_page/main": {
      "schema": "object",
      "description": "Main services landing page configuration"
    },
    "services/{serviceId}": {
      "schema": "object",
      "description": "Enterprise-grade AV/communication services catalog"
    },
    "settings/{docId}": {
      "schema": "object",
      "description": "Global, catalog tombstones, payment, AI agent, and Facebook Page integration settings"
    },
    "facebook_posts/{postId}": {
      "schema": "FacebookPost",
      "description": "History of products and services published to the connected Facebook Page"
    },
    "stock_history/{historyId}": {
      "schema": "object",
      "description": "Inventory stock adjustment history logs"
    },
    "page_contents/{pageId}": {
      "schema": "object",
      "description": "Dynamic custom page content documents"
    },
    "ai_leads/{leadId}": {
      "schema": "AILead",
      "description": "Omnichannel sales leads captured by the AV Live AI Agent"
    },
    "ai_conversations/{conversationId}": {
      "schema": "AIConversation",
      "description": "Omnichannel WhatsApp, 3CX phone, and web AI chat transcripts with button metadata"
    },
    "ai_approval_queue/{itemId}": {
      "schema": "AIApprovalItem",
      "description": "Admin confirmation queue for outbound Gmail quotes, email follow-ups, daily reports, and WhatsApp pushes"
    },
    "ai_tasks/{taskId}": {
      "schema": "AITask",
      "description": "Automated Day +1/+3/+7 follow-up cadence tasks with optional Google Tasks sync"
    },
    "ai_daily_reports/{reportId}": {
      "schema": "AIDailyReport",
      "description": "Daily executive operations summaries generated by the AI Agent"
    }
  }
}
